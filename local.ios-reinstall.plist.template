<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>{{LABEL}}</string>
	<key>ProgramArguments</key>
	<array>
		<string>{{TRIGGER}}</string>
		<string>{{RUBY}}</string>
		<string>{{SCRIPT}}</string>
		<string>--on-connect</string>
	</array>
	<!-- iPhone が USB でつながったときに起動する。Apple Watch の充電ケーブルなども Apple 製(idVendor 1452)なので、
	     iPhone の製品 ID(4776 = 0x12a8)で絞る。USB Product Name を IOPropertyMatch で絞る形では起動しなかった -->
	<key>LaunchEvents</key>
	<dict>
		<key>com.apple.iokit.matching</key>
		<dict>
			<key>{{LABEL}}.iphone</key>
			<dict>
				<key>IOProviderClass</key>
				<string>IOUSBHostDevice</string>
				<key>idVendor</key>
				<integer>1452</integer>
				<key>idProduct</key>
				<integer>4776</integer>
				<key>IOMatchLaunchStream</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>EnvironmentVariables</key>
	<dict>
		<!-- xcodegen(Homebrew)と git を見つけられるようにする -->
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>DEVELOPER_DIR</key>
		<string>/Applications/Xcode.app/Contents/Developer</string>
		<!-- LANG が無いと osascript に渡す日本語が化ける -->
		<key>LANG</key>
		<string>ja_JP.UTF-8</string>
	</dict>
	<key>StandardOutPath</key>
	<string>{{LOG}}</string>
	<key>StandardErrorPath</key>
	<string>{{LOG}}</string>
</dict>
</plist>
